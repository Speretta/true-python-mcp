#!/usr/bin/env bash
# Reject commit messages that do not follow Conventional Commits.
#
#   type(scope)!: subject          subject starts lowercase, no trailing dot
#   types: feat fix refactor perf docs test build ci chore
#
# Optional footers steer the release bump (see scripts/release.sh):
#   "Bump: minor" / "Bump: major" / "BREAKING CHANGE: ..."
set -euo pipefail
# ASCII regex semantics regardless of the user's locale (some locales, e.g.
# tr_TR, exclude 'i' from [a-z] in glibc regex ranges).
export LC_ALL=C

message_file="$1"
subject="$(head -n1 "$message_file")"

# Merge, revert and fixup commits are generated by git; let them through.
case "$subject" in
    Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|refactor|perf|docs|test|build|ci|chore)(\([a-z0-9_.-]+\))?(!)?: [a-z0-9].*'
if ! [[ "$subject" =~ $pattern ]]; then
    echo "commit-msg: rejected subject: $subject" >&2
    echo "  expected: type(scope)!: subject   (lowercase subject)" >&2
    echo "  types: feat fix refactor perf docs test build ci chore" >&2
    exit 1
fi

if grep -q '^Bump: ' "$message_file" && ! grep -qE '^Bump: (minor|major)$' "$message_file"; then
    echo "commit-msg: 'Bump:' footer must be exactly 'Bump: minor' or 'Bump: major'" >&2
    exit 1
fi
